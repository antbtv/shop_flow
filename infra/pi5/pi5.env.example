# Template for ~/shopflow/.env on Pi5 (ADR-0007). Only Pi5 variables: laptop secrets never go there.
# On Pi5: cp pi5.env.example .env && chmod 600 .env, then set a new password.
PI5_HOST=192.168.0.151
CLICKHOUSE_USER=shopflow
CLICKHOUSE_PASSWORD=changeme

# Airflow (Milestone 4, ADR-0010). Generate secrets URL-safe: openssl rand -hex 24
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_DB_PASSWORD=changeme
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=changeme
# Pinned subnet of the Pi5 compose network (airflow_reader HOST IP).
PI5_COMPOSE_SUBNET=
CLICKHOUSE_AIRFLOW_PASSWORD=changeme
# Grafana (M5, ADR-0011). Hex only (openssl rand -hex 24).
CLICKHOUSE_GRAFANA_PASSWORD=changeme
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_SECRET_KEY=changeme
# Alerts (FR-11): fill by hand on Pi5, only the Airflow scheduler reads them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Reconciliation source: laptop Postgres, read-only role (the only laptop secret on Pi5).
LAPTOP_HOST=192.168.0.105
RECON_READER_PASSWORD=changeme
