<!-- Per-query limits for every user (profile "default"). One heavy query must not take the whole
     2 GB server budget (max_server_memory_usage): big GROUP BY and ORDER BY spill to disk instead. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>1610612736</max_memory_usage>
            <max_bytes_before_external_group_by>805306368</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>805306368</max_bytes_before_external_sort>
        </default>
    </profiles>
</clickhouse>
