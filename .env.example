# Copy to .env and fill in real values. Never commit .env.

# Postgres (laptop). localhost is correct for processes on the laptop only.
POSTGRES_HOST=localhost
POSTGRES_DB=shopflow
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=changeme
# Debezium replication role (ADR-0005), created by postgres/init on first start.
DEBEZIUM_PASSWORD=changeme

# Kafka (laptop)
KAFKA_BOOTSTRAP=localhost:9092

# Pi5: LAN IP (not a hostname). Also used as the bind address for published container ports.
PI5_HOST=192.168.0.151
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=shopflow
CLICKHOUSE_PASSWORD=changeme
# Spark streaming job writer (ADR-0008), created by scripts/create-ch-users.sh.
CLICKHOUSE_SPARK_PASSWORD=changeme
# Subnet the writer may connect from (the laptop's LAN).
LAN_SUBNET=192.168.0.0/24

# Airflow (Pi5)
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# Alerts (FR-11)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reconciliation Pi5 -> laptop Postgres (FR-8, ADR-0010).
# Laptop LAN IP (DHCP reservation); Postgres is published on it and on 127.0.0.1.
LAPTOP_HOST=192.168.0.105
# Laptop compose network, pinned: pg_hba trusts it for Debezium and the host (via docker-proxy).
LAPTOP_COMPOSE_SUBNET=10.10.4.0/24
# Read-only role for the reconciliation DAG, created by scripts/create-pg-reader.sh. Hex only: it goes into a URI.
RECON_READER_PASSWORD=changeme
# ClickHouse user for Airflow, created by scripts/create-ch-users.sh from the laptop.
CLICKHOUSE_AIRFLOW_PASSWORD=changeme
# Pi5 compose network, pinned: airflow_reader may connect only from it.
PI5_COMPOSE_SUBNET=
